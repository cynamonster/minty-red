{
  "name": "minty-red",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-og-routes.js",
    "generate:og": "swift -module-cache-path /tmp/swift-cache scripts/generate-og-images.swift",
    "preview": "vite preview",
    "deploy:manual": "npm run build && wrangler pages deploy dist --project-name=minty-red",
    "deploy:manual:preview": "npm run build && wrangler pages deploy dist --project-name=minty-red --branch=preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
